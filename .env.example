# ==============================================================================
# AVISHKAR-v2 Environment Configuration Template
# Copy this file to .env.local and populate the values for local development.
# ==============================================================================

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here

# Optional: Supabase Server-Only Secret Key
# WARNING: NEVER prefix with NEXT_PUBLIC_. Only use in server-side API routes.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Payment Details Overrides (leave empty for unconfigured/provisional state)
# NEXT_PUBLIC_REGISTRATION_FEE=
# NEXT_PUBLIC_PAYMENT_UPI_ID=
# NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME=
# NEXT_PUBLIC_PAYMENT_QR_URL=

# Groq AI Form Generation (Server-only)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Google Forms API Integration (Server-only)
# Option 1: Service Account (Recommended for automated creation & sync)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=forms-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2: OAuth 2.0 Credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token

